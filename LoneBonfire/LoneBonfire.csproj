<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net48</TargetFramework>
		<AssemblyName>LoneBonfire</AssemblyName>
		<Product>Lone Bonfire</Product>
		<Version>1.1.1</Version>
		<LangVersion>latest</LangVersion>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
		<DebugType>none</DebugType>

		<!-- game + loader paths, edit to your install (see readme) -->
		<BepInExCore>..\..\core</BepInExCore>
		<GameManaged>..\..\..\Super Fantasy Kingdom_Data\Managed</GameManaged>
	</PropertyGroup>

	<!-- net48 reference assemblies without visual studio -->
	<ItemGroup>
		<PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
	</ItemGroup>

	<!-- bepinex + harmony -->
	<ItemGroup>
		<Reference Include="BepInEx">
			<HintPath>$(BepInExCore)\BepInEx.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="0Harmony">
			<HintPath>$(BepInExCore)\0Harmony.dll</HintPath>
			<Private>false</Private>
		</Reference>
	</ItemGroup>

	<!-- game assemblies -->
	<ItemGroup>
		<Reference Include="Assembly-CSharp">
			<HintPath>$(GameManaged)\Assembly-CSharp.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityEngine">
			<HintPath>$(GameManaged)\UnityEngine.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityEngine.CoreModule">
			<HintPath>$(GameManaged)\UnityEngine.CoreModule.dll</HintPath>
			<Private>false</Private>
		</Reference>
	</ItemGroup>

</Project>
